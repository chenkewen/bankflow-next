{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BankFlow Next",
  "version": "1.0.1",
  "identifier": "local.bankflow.workbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BankFlow Next 文件工作台",
        "width": 1120,
        "height": 820,
        "minWidth": 700,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "../resources/brand/app.ico"
    ],
    "targets": [
      "nsis"
    ],
    "resources": {
      "../build/native-runtime/pdfium.dll": "runtime/pdfium.dll",
      "../build/native-runtime/onnxruntime.dll": "runtime/onnxruntime.dll",
      "../build/native-runtime/avifdec.exe": "runtime/avifdec.exe",
      "../build/native-runtime/models/ch_PP-OCRv4_det_infer.onnx": "runtime/models/ch_PP-OCRv4_det_infer.onnx",
      "../build/native-runtime/models/ch_PP-OCRv4_rec_infer.onnx": "runtime/models/ch_PP-OCRv4_rec_infer.onnx"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "../resources/brand/app.ico",
        "uninstallerIcon": "../resources/brand/app.ico"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
